rules_version = '2';
service cloud.firestore {
  // ============================================================
  // PAROLE - Règles Firestore (Phase 1 à Phase 6)
  // PRINCIPE ABSOLU : DENY BY DEFAULT.
  //   - Aucune lecture/écriture sans règle explicite.
  //   - Un utilisateur ne peut modifier que ses propres données.
  //   - Les champs sensibles (role, banned, counters, modération,
  //     auditLogs) ne sont JAMAIS modifiables par un client.
  //   - Toutes les mutations sensibles passent par les Cloud
  //     Functions (Admin SDK) qui écrivent aussi auditLogs.
  // ============================================================

  match /databases/{database}/documents {

    // ----------------------------------------------------------
    // Helpers
    // ----------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Rôle d'un utilisateur. 'none' si le profil n'existe pas
    // (couvre les cas limite sans lever d'erreur).
    function getUserRole(uid) {
      return userDocExists(uid) ? getUserData(uid).role : 'none';
    }

    function isAdmin() {
      return isSignedIn() && getUserRole(request.auth.uid) == 'admin';
    }

    function isModerator() {
      return isSignedIn() && getUserRole(request.auth.uid) in ['moderator', 'admin'];
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBanned(uid) {
      return userDocExists(uid) && getUserData(uid).banned == true;
    }

    // Un compte peut créer du contenu : connecté, profil présent,
    // non banni.
    function canAct() {
      return isSignedIn() && userDocExists(request.auth.uid) && !isBanned(request.auth.uid);
    }

    // ----------------------------------------------------------
    // Messagerie (Phase 9 — Lot 3)
    // Une conversation a un ID DÉTERMINISTE : les participants
    // (deux, distincts) triés en ordre croissant, séparés par '_'.
    // Une seule conversation par paire : un second setDoc sur le
    // même ID devient un UPDATE -> refusé (document immuable côté
    // client ; seules les Cloud Functions actualisent lastMessage*).
    // ----------------------------------------------------------
    function canonicalConversationId(p0, p1) {
      return (p0 <= p1) ? (p0 + '_' + p1) : (p1 + '_' + p0);
    }

    function conversationExists(conversationId) {
      return exists(/databases/$(database)/documents/conversations/$(conversationId));
    }

    function getConversationData(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
    }

    // `uid` est-il l'un des deux participants (doc bien formé) ?
    // La forme `uid in participants` est OBLIGATOIRE pour rester
    // compatible avec les requêtes `participants array-contains`
    // (l'évaluateur ne sait pas prouver les opérateurs `is list` /
    // taille sur le champ filtré). Un doc mal formé (participants
    // non-liste) provoque une erreur d'évaluation -> refus.
    function isConversationParticipant(uid, convData) {
      return uid in convData.participants;
    }

    // L'autre participant d'une conversation (par rapport à `uid`).
    function otherConversationParticipant(uid, convData) {
      return convData.participants[0] == uid
        ? convData.participants[1]
        : convData.participants[0];
    }

    // Lecture d'une conversation / d'un message : participant NON
    // banni OU modérateur/admin. Un banni ne peut ni lire ni
    // marquer comme lu ; un modérateur/admin peut lire (prérequis
    // de modération) mais ne peut PAS écrire dans une conversation.
    function canReadConversation(uid, conversationId) {
      return isModerator()
        || (isSignedIn()
            && !isBanned(uid)
            && conversationExists(conversationId)
            && isConversationParticipant(uid, getConversationData(conversationId)));
    }

    // Envoi d'un message : canAct() + conversation existante +
    // participation + aucun blocage dans AUCUNE direction.
    // `exists()` sur les deux directions (`alice_bob` ou
    // `bob_alice`) rend le blocage BIDIRECTIONNEL : impossible
    // d'écrire à qui vous a bloqué, impossible d'écrire à un
    // utilisateur que vous avez bloqué.
    function canSendMessage(uid, conversationId) {
      return canAct()
        && conversationExists(conversationId)
        && isConversationParticipant(uid, getConversationData(conversationId));
    }

    function notBlockedBetween(uid, conversationId) {
      return !exists(/databases/$(database)/documents/blocks/$(uid + '_' + otherConversationParticipant(uid, getConversationData(conversationId))))
        && !exists(/databases/$(database)/documents/blocks/$(otherConversationParticipant(uid, getConversationData(conversationId)) + '_' + uid));
    }

    // L'utilisateur suit-il l'auteur ? (collection `follows`,
    // prévue pour une phase ultérieure. Par défaut : non.)
    function followsAuthor(authorId) {
      return exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + authorId));
    }

    // Un post (données déjà récupérées) est-il lisible ?
    function isPostDataReadable(data) {
      return isSignedIn()
        && (data.authorId == request.auth.uid
            || isModerator()
            || (!('deletedAt' in data)
                && data.moderationStatus == 'visible'
                && (data.visibility == 'public'
                    || (data.visibility == 'followers' && followsAuthor(data.authorId)))));
    }

    // Un post est-il lisible par le demandeur ? (appelé avec `get`)
    function isPostReadable(postId) {
      return isSignedIn()
        && (isModerator()
            || (exists(/databases/$(database)/documents/posts/$(postId))
                && isPostDataReadable(get(/databases/$(database)/documents/posts/$(postId)).data)));
    }

    // ----------------------------------------------------------
    // Hashtags (Phase 9 — Lot 1)
    // Convention DÉTERMINISTE : un hashtag est stocké en MINUSCULES,
    // SANS le caractère '#', composé uniquement de [0-9a-z_], de 1 à
    // 32 caractères. L'extraction/normalisation est faite côté client ;
    // la règle REFUSE toute valeur non normalisée (majuscules,
    // accents, espaces, '#' inclus) : impossible d'introduire des tags
    // « déguisés » qui contourneraient la normalisation.
    // Le champ posts.hashtags reste OPTIONNEL (compatibilité posts
    // existants) ; un tableau vide est accepté. La déduplication des
    // doublons est côté client (le langage de règles n'offre pas
    // d'itération : la validation est bornée, élément par élément).
    function isValidHashtag(tag) {
      return tag is string && tag.matches('^[0-9a-z_]{1,32}$');
    }

    function isValidHashtags(hts) {
      return hts is list
        && hts.size() <= 10
        && (hts.size() == 0 || (isValidHashtag(hts[0])
          && (hts.size() <= 1 || (isValidHashtag(hts[1])
          && (hts.size() <= 2 || (isValidHashtag(hts[2])
          && (hts.size() <= 3 || (isValidHashtag(hts[3])
          && (hts.size() <= 4 || (isValidHashtag(hts[4])
          && (hts.size() <= 5 || (isValidHashtag(hts[5])
          && (hts.size() <= 6 || (isValidHashtag(hts[6])
          && (hts.size() <= 7 || (isValidHashtag(hts[7])
          && (hts.size() <= 8 || (isValidHashtag(hts[8])
          && (hts.size() <= 9 || isValidHashtag(hts[9]))))))))))))))))))));
    }

    function validReason(reason) {
      return reason in ['illegal', 'harassment', 'spam', 'hate', 'sexual', 'violence', 'doxxing', 'fraud', 'other'];
    }

    // ----------------------------------------------------------
    // users/{userId}
    // Champs publics : uid, displayName, bio, avatarPath, createdAt,
    // updatedAt.
    // Champs système (jamais écrits par un client) : role, banned,
    // bannedUntil, moderationStatus, moderationNote, postCount,
    // reportCount, likeCount, followerCount, followingCount,
    // notificationCount.
    // ----------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();

      // Création du profil : l'utilisateur ne peut créer QUE son
      // propre profil, avec le rôle par défaut 'user', non banni.
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.banned == false
        && !('bannedUntil' in request.resource.data)
        && request.resource.data.moderationStatus == 'none'
        && request.resource.data.postCount == 0
        && request.resource.data.reportCount == 0
        && request.resource.data.likeCount == 0
        && request.resource.data.followerCount == 0
        && request.resource.data.followingCount == 0
        && request.resource.data.notificationCount == 0
        && request.resource.data.messageCount == 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'bio', 'avatarPath', 'createdAt',
          'updatedAt', 'role', 'banned', 'moderationStatus',
          'postCount', 'reportCount', 'likeCount',
          'followerCount', 'followingCount', 'notificationCount',
          'messageCount'
        ]);

      // Mise à jour par le propriétaire : champs de profil uniquement.
      // Interdit de toucher role, banned, moderationStatus, counters.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'bio', 'avatarPath', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.banned == resource.data.banned
        && request.resource.data.moderationStatus == resource.data.moderationStatus
        && request.resource.data.postCount == resource.data.postCount
        && request.resource.data.reportCount == resource.data.reportCount
        && request.resource.data.likeCount == resource.data.likeCount
        && request.resource.data.followerCount == resource.data.followerCount
        && request.resource.data.followingCount == resource.data.followingCount
        && request.resource.data.notificationCount == resource.data.notificationCount
        && request.resource.data.messageCount == resource.data.messageCount;

      // Suppression de profil : jamais via un client.
      allow delete: if false;
    }

    // ----------------------------------------------------------
    // posts/{postId}
    // Champs système : likeCount, commentCount, reportCount,
    // shareCount (incréments via Cloud Functions uniquement),
    // moderationStatus, moderationReason, moderatorId, moderatedAt.
    // ----------------------------------------------------------
    match /posts/{postId} {
      allow read: if isPostDataReadable(resource.data);

      allow create: if canAct()
        && request.resource.data.authorId == request.auth.uid
        && 'content' in request.resource.data
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 5000
        && request.resource.data.type in ['text', 'image', 'video', 'audio']
        && request.resource.data.visibility in ['public', 'followers', 'private']
        && request.resource.data.moderationStatus == 'visible'
        && !('deletedAt' in request.resource.data)
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.reportCount == 0
        && request.resource.data.shareCount == 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!('hashtags' in request.resource.data) || isValidHashtags(request.resource.data.hashtags))
        && request.resource.data.keys().hasOnly([
          'authorId', 'authorName', 'content', 'type', 'visibility',
          'mediaPaths', 'createdAt', 'updatedAt', 'likeCount',
          'commentCount', 'reportCount', 'shareCount', 'moderationStatus',
          'hashtags'
        ]);

      // L'auteur peut modifier contenu, visibilité, médias et
      // hashtags. Jamais les compteurs ni les champs de modération.
      allow update: if isOwner(resource.data.authorId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['content', 'visibility', 'mediaPaths', 'hashtags', 'updatedAt'])
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.moderationStatus == resource.data.moderationStatus
        && request.resource.data.likeCount == resource.data.likeCount
        && request.resource.data.commentCount == resource.data.commentCount
        && request.resource.data.reportCount == resource.data.reportCount
        && request.resource.data.shareCount == resource.data.shareCount
        && (!('hashtags' in request.resource.data) || isValidHashtags(request.resource.data.hashtags));

      // Suppression : uniquement l'auteur du post.
      allow delete: if isOwner(resource.data.authorId);
    }

    // ----------------------------------------------------------
    // comments/{commentId}
    // ----------------------------------------------------------
    match /comments/{commentId} {
      // Lecture : seul le post parent doit être lisible ET le commentaire
      // doit être visible (ou le demandeur un modérateur/admin). Un
      // utilisateur normal ne lit pas un commentaire masqué/retiré, même
      // s'il est l'auteur du post parent.
      allow read: if isPostReadable(resource.data.postId)
        && (isModerator() || resource.data.moderationStatus == 'visible');

      allow create: if canAct()
        && request.resource.data.authorId == request.auth.uid
        && 'postId' in request.resource.data
        && request.resource.data.postId is string
        && isPostReadable(request.resource.data.postId)
        && 'content' in request.resource.data
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.moderationStatus == 'visible'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'postId', 'authorId', 'content', 'replyToId', 'createdAt',
          'updatedAt', 'moderationStatus', 'deletedAt'
        ]);

      allow update: if isOwner(resource.data.authorId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['content', 'updatedAt'])
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.moderationStatus == resource.data.moderationStatus;

      allow delete: if isOwner(resource.data.authorId);
    }

    // ----------------------------------------------------------
    // likes/{likeId}
    // Un like par utilisateur et par post : DÉDUPLICATION par ID
    // déterministe `likeId = ${userId}_${postId}` (imposé par la
    // règle de création). Un second like est un setDoc sur un
    // document existant -> UPDATE -> refusé. Le retrait d'un like
    // est une suppression réservée à son auteur.
    // Les compteurs (posts.likeCount et users.likeCount des likes
    // reçus) sont maintenus par les Cloud Functions
    // (onLikeCreated / onLikeDeleted) — jamais par un client.
    // ----------------------------------------------------------
    match /likes/{likeId} {
      allow read: if isSignedIn();

      allow create: if canAct()
        && request.resource.data.userId == request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.postId
        && 'postId' in request.resource.data
        && request.resource.data.postId is string
        && request.resource.data.postId.size() > 0
        && isPostReadable(request.resource.data.postId)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'userId', 'postId', 'createdAt', 'updatedAt'
        ]);

      // Un like est immuable : on like ou on retire, jamais de
      // modification.
      allow update: if false;

      // Retrait d'un like : uniquement son auteur.
      allow delete: if isOwner(resource.data.userId);
    }

    // ----------------------------------------------------------
    // shares/{shareId} (Phase 6)
    // Partage / renvoi d'une publication. DÉDUPLICATION par ID
    // déterministe `shareId = ${userId}_${postId}` (imposé par la
    // règle de création). Un second partage est un setDoc sur un
    // document existant -> UPDATE -> refusé. Un partage est IMMUABLE.
    // Les compteurs (posts.shareCount) sont maintenus par les Cloud
    // Functions (onShareCreated / onShareDeleted) — jamais par un
    // client. Aucun compteur users.shareCount (un partage n'est pas
    // un indicateur valorisé du profil). Lecture : tout utilisateur
    // connecté (requête « mes partages » mono-champ, aucun index
    // composite).
    // ----------------------------------------------------------
    match /shares/{shareId} {
      allow read: if isSignedIn();

      allow create: if canAct()
        && request.resource.data.userId == request.auth.uid
        && shareId == request.auth.uid + '_' + request.resource.data.postId
        && 'postId' in request.resource.data
        && request.resource.data.postId is string
        && request.resource.data.postId.size() > 0
        && isPostReadable(request.resource.data.postId)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'userId', 'postId', 'createdAt', 'updatedAt'
        ]);

      // Un partage est immuable : on partage ou on retire, jamais de
      // modification.
      allow update: if false;

      // Retrait d'un partage : uniquement son auteur.
      allow delete: if isOwner(resource.data.userId);
    }

    // ----------------------------------------------------------
    // reports/{reportId}
    // DÉDUPLICATION : reportId = `${reporterId}_${targetType}_${targetId}`.
    // Un même utilisateur ne peut donc créer qu'UN signalement par
    // cible. Le doc id déterministe rend l'écrasement impossible
    // (un second signalement serait un update → refusé).
    // AUCUN signalement ne supprime, ne masque ni ne modifie un post.
    // ----------------------------------------------------------
    match /reports/{reportId} {
      allow create: if canAct()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportId == reportId
        && reportId == request.auth.uid + '_' + request.resource.data.targetType + '_' + request.resource.data.targetId
        && request.resource.data.targetType in ['post', 'comment', 'user']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && validReason(request.resource.data.reason)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        // La cible doit exister.
        && (request.resource.data.targetType != 'post'
            || exists(/databases/$(database)/documents/posts/$(request.resource.data.targetId)))
        && request.resource.data.keys().hasOnly([
          'reporterId', 'reportId', 'targetType', 'targetId',
          'reason', 'details', 'status', 'createdAt'
        ]);

      // L'auteur du signalement peut le lire ; les modérateurs
      // peuvent tout lire.
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.reporterId || isModerator());

      // Le statut/résolution d'un signalement n'est modifiable que
      // par les Cloud Functions (Admin SDK), pour traçabilité.
      allow update, delete: if false;
    }

    // ----------------------------------------------------------
    // moderationQueue/{queueId}
    // Créée et mise à jour par les Cloud Functions (déclencheurs
    // onReportCreated + actions de modération). Aucun client ne peut
    // écrire ici. États : pending, reviewing, resolved, dismissed.
    // ----------------------------------------------------------
    match /moderationQueue/{queueId} {
      allow read: if isSignedIn() && isModerator();
      allow create, update, delete: if false;
    }

    // ----------------------------------------------------------
    // notifications/{notificationId}
    // Créées EXCLUSIVEMENT par les Cloud Functions (Admin SDK) :
    // le client ne peut ni créer ni supprimer une notification et
    // ne peut modifier ni recipientId, ni actorId, ni type, ni
    // postId, ni commentId, ni createdAt. Le destinataire peut
    // UNIQUEMENT marquer une notification NON LUE comme lue
    // (read = true + readAt timestamp). Une notification déjà lue
    // est immuable — ceci rend le décrément de
    // users.notificationCount exactement unitaire (idempotent).
    // ----------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && (resource.data.recipientId == request.auth.uid || isAdmin());

      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.actorId == resource.data.actorId
        && request.resource.data.type == resource.data.type
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.commentId == resource.data.commentId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read', 'readAt'])
        && request.resource.data.read == true
        && request.resource.data.readAt is timestamp
        && !(resource.data.read == true);

      allow create, delete: if false;
    }

    // ----------------------------------------------------------
    // auditLogs/{logId}
    // Journal des actions administratives et de modération. Écrit
    // EXCLUSIVEMENT par les Cloud Functions (Admin SDK). Lecture
    // réservée aux administrateurs.
    // ----------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isSignedIn() && isAdmin();
      allow create, update, delete: if false;
    }

    // ----------------------------------------------------------
    // follows/{followId}
    // Abonnements. DÉDUPLICATION par ID déterministe
    // `followId = ${followerId}_${followingId}` (imposé par la règle
    // de création). Un second follow est un setDoc sur un document
    // existant -> UPDATE -> refusé. Un follow est IMMUABLE : le
    // retrait est une suppression réservée au follower.
    // Ininterdits : se suivre soi-même, suivre un profil inexistant
    // ou un profil banni; un utilisateur banni ne peut pas suivre
    // (canAct()).
    // Les compteurs (users.followingCount du suiveur et
    // users.followerCount du suivi) sont maintenus par les Cloud
    // Functions (onFollowCreated / onFollowDeleted) — jamais par un
    // client.
    // ----------------------------------------------------------
    match /follows/{followId} {
      // Lecture : le follower, le suivi, ou modérateur/admin. Une
      // telle règle empêche d'énumérer les abonnements d'autrui ;
      // la visibilité `followers` des posts ne dépend pas de ce droit
      // de lecture (exists() reste autorisé dans les règles).
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.followerId
            || request.auth.uid == resource.data.followingId
            || isModerator());

      allow create: if canAct()
        && request.resource.data.followerId == request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followingId
        && 'followingId' in request.resource.data
        && request.resource.data.followingId is string
        && request.resource.data.followingId.size() > 0
        && request.resource.data.followingId != request.auth.uid
        // La cible doit exister et ne pas être bannie.
        && exists(/databases/$(database)/documents/users/$(request.resource.data.followingId))
        && !isBanned(request.resource.data.followingId)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'followerId', 'followingId', 'createdAt', 'updatedAt'
        ]);

      // Un follow est immuable : on suit ou on ne suit plus.
      allow update: if false;

      // Retrait d'un follow : uniquement le follower.
      allow delete: if isOwner(resource.data.followerId);
    }

    // ----------------------------------------------------------
    // blocks/{blockId} (Phase 9 — Lot 2)
    // Blocage utilisateur. ID DÉTERMINISTE
    // `blockId = ${blockerId}_${blockedId}` (imposé par la règle de
    // création) : un même couple ne peut exister qu'en un seul
    // document, un second setDoc devient un UPDATE -> refusé.
    // Le blocage est DIRECTIONNEL au niveau du document (alice_bob =
    // Alice bloque Bob), MAIS son effet de sécurité futur (messagerie,
    // Lot 3) sera BIDIRECTIONNEL : les règles `messages` devront
    // vérifier les deux directions via exists(). Aucun document
    // inverse automatique : le blocage reste une décision personnelle.
    // Champs strictement limités à blockerId, blockedId, createdAt
    // (hasOnly exact) : schéma minimal, aucune donnée sensible.
    // Création : canAct() (connecté, profil présent, non banni),
    // blockerId == auth.uid, côté opposé distinct de soi, cible
    // existante et non bannie (même contrainte que les follows).
    // Lecture : le blocker seul (ou modérateur/admin). Le bloqué et
    // les tiers ne lisent PAS le document : impossible d'énumérer les
    // blocages d'autrui (le moteur impose une requête bornée sur
    // blockerId). Les futurs contrôles de messagerie utiliseront
    // exists(), qui ne dépend pas de ce droit de lecture.
    // UPDATE : toujours refusé (un blocage est immuable).
    // DELETE : uniquement le blocker (isOwner). Un utilisateur banni
    // peut encore débloquer — aligné sur la convention follow/like/
    // share (delete = isOwner, pas canAct) — mais ne peut PAS créer
    // de nouveau blocage (create exige canAct()).
    // Aucune Cloud Function : rien à compter, rien à tracer.
    // ----------------------------------------------------------
    match /blocks/{blockId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.blockerId || isModerator());

      allow create: if canAct()
        && 'blockedId' in request.resource.data
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId is string
        && request.resource.data.blockedId.size() > 0
        && request.resource.data.blockedId != request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.blockedId
        // La cible doit exister et ne pas être bannie.
        && exists(/databases/$(database)/documents/users/$(request.resource.data.blockedId))
        && !isBanned(request.resource.data.blockedId)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly([
          'blockerId', 'blockedId', 'createdAt'
        ]);

      // Un blocage est immuable : on bloque ou on débloque, jamais de
      // modification.
      allow update: if false;

      // Retrait d'un blocage : uniquement le blocker.
      allow delete: if isOwner(resource.data.blockerId);
    }

    // ----------------------------------------------------------
    // conversations/{conversationId} (Phase 9 — Lot 3)
    // Messagerie privée 1-à-1. ID DÉTERMINISTE : participants triés
    // séparés par '_' (imposé par la règle de création) -> une seule
    // conversation par paire, un second setDoc devient un UPDATE ->
    // refusé. Champs : participants (string[2] triées, distinctes,
    // contient le créateur), createdAt, lastMessageAt / lastMessage
    // Preview / lastSenderId (vides à la création, actualisés UNIQUE
    // MENT par les Cloud Functions onMessageCreated/onMessageUpdated
    // — le client ne peut donc pas falsifier l'état d'une
    // conversation). Le document est IMMUABLE côté client (update /
    // delete refusés, y compris pour un modérateur).
    // Lecture : participant non banni OU modérateur/admin — jamais le
    // banni, et les documents hors accès ne sont pas lisibles (pas
    // d'énumération globale ; la requête « mes conversations » est
    // bornée par `participants array-contains`).
    // ----------------------------------------------------------
    match /conversations/{conversationId} {
      // Lecture : participant non banni OU modérateur/admin. La règle
      // s'appuie sur `resource.data` (jamais de get() auto-référent)
      // : la requête de l'inbox (`participants array-contains` +
      // orderBy lastMessageAt) reste donc compatible.
      allow read: if isSignedIn()
        && (isModerator()
            || (!isBanned(request.auth.uid)
                && isConversationParticipant(request.auth.uid, resource.data)));

      allow create: if canAct()
        && 'participants' in request.resource.data
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0].size() > 0
        && request.resource.data.participants[1].size() > 0
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.resource.data.participants[0] <= request.resource.data.participants[1]
        && (request.resource.data.participants[0] == request.auth.uid
            || request.resource.data.participants[1] == request.auth.uid)
        && canonicalConversationId(
             request.resource.data.participants[0],
             request.resource.data.participants[1]
           ) == conversationId
        && request.resource.data.createdAt is timestamp
        && request.resource.data.lastMessageAt == null
        && request.resource.data.lastMessagePreview == ''
        && request.resource.data.lastSenderId == ''
        && request.resource.data.keys().hasOnly([
          'participants', 'createdAt', 'lastMessageAt',
          'lastMessagePreview', 'lastSenderId'
        ]);

      // Le client ne peut JAMAIS modifier une conversation (l'état de
      // la conversation est actualisé uniquement par les Cloud
      // Functions onMessageCreated / onMessageUpdated).
      allow update: if false;
      allow delete: if false;
    }

    // ----------------------------------------------------------
    // messages/{messageId} (Phase 9 — Lot 3)
    // Messages privés 1-à-1 au sein d'une conversation. Création via
    // addDoc (ID auto) : canAct() (connecté, profil présent, non
    // banni), senderId == auth.uid, conversation existante + parti
    // cipation, CONTENU 1..2000 caractères, read == false,
    // readAt == null, moderationStatus == 'visible', et AUCUN
    // blocage dans l'une OU l'autre direction (effet bidirectionnel
    // du blocage — Lot 2). Le contenu ne peut pas être modifié ni
    // supprimé (document immuable côté client).
    // Lecture : participant non banni OU modérateur/admin. Un banni
    // ne lit pas ses messages, même anciens. L'historique reste
    // lisible après un blocage pour les participants non bannis
    // (un blocage n'efface pas l'historique).
    // Mise à jour UNIQUE autorisée : le passage read false -> true
    // + readAt timestamp, uniquement par le DESTINATAIRE (senderId
    // != auth.uid), non banni et participant. Un auteur ne peut pas
    // marquer son propre message comme lu ; un modérateur/admin ne
    // contourne pas (réserve au destinataire) ; true -> false
    // refusé ; déjà lu immuable (décrément exactement unitaire du
    // compteur users.messageCount côté server triggers).
    // ----------------------------------------------------------
    match /messages/{messageId} {
      allow read: if canReadConversation(request.auth.uid, resource.data.conversationId);

      allow create: if canSendMessage(request.auth.uid, request.resource.data.conversationId)
        && 'conversationId' in request.resource.data
        && request.resource.data.conversationId is string
        && request.resource.data.senderId == request.auth.uid
        && notBlockedBetween(request.auth.uid, request.resource.data.conversationId)
        && 'content' in request.resource.data
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.read == false
        && request.resource.data.readAt == null
        && request.resource.data.moderationStatus == 'visible'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly([
          'conversationId', 'senderId', 'content', 'read', 'readAt',
          'moderationStatus', 'createdAt'
        ]);

      allow update: if isSignedIn()
        && !isBanned(request.auth.uid)
        && resource.data.senderId != request.auth.uid
        && resource.data.read == false
        && request.resource.data.read == true
        && request.resource.data.readAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read', 'readAt'])
        && request.resource.data.conversationId == resource.data.conversationId
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.moderationStatus == resource.data.moderationStatus
        && request.resource.data.createdAt == resource.data.createdAt
        && conversationExists(resource.data.conversationId)
        && isConversationParticipant(request.auth.uid, getConversationData(resource.data.conversationId));

      // Un message n'est jamais supprimé par un client.
      allow delete: if false;
    }

    // ----------------------------------------------------------
    // appeals/{appealId} (Phase 9 — Lot 4)
    // Recours contre une sanction de modération. DÉDUPLICATION par ID
    // DÉTERMINISTE `appealId = ${appellantId}_${targetType}_${targetId}`
    // (imposé par la règle) : un second setDoc devient un UPDATE ->
    // refusé. Un recours ne peut exister qu'EN UN exemplaire par couple
    // (appelant, cible) : la règle empêche tout doublon.
    // Création : canAct() (connecté, profil présent, NON banni) +
    // appellantId == auth.uid + cible APPARTENANT à l'appelant (post/
    // comment : auteur ; user : l'appelant lui-même) + cible RÉELLEMENT
    // sanctionnée au moment du dépôt (post/comment :
    // moderationStatus 'hidden'/'removed' cohérent avec sanctionType ;
    // user : moderationStatus 'warned', ou banned + 'suspended') +
    // sanctionType cohérent avec l'état réel + reason 1..2000 +
    // status == 'pending' + createdAt timestamp + hasOnly strict.
    // Un utilisateur banni ne peut PAS déposer de recours (canAct) —
    // y compris pour contester un bannissement (décision de conception,
    // non levable par le client).
    // Lecture : l'appelant concerné ou un modérateur/admin (requêtes
    // « mes recours » bornées sur appellantId et « recours à traiter »
    // bornées sur status — aucune énumération globale).
    // UPDATE/DELETE : toujours refusés côté client. Le document est
    // IMMUABLE : la décision passe EXCLUSIVEMENT par la Cloud Function
    // `reviewAppeal` (Admin SDK) qui restaure la cible, clôt le recours,
    // trace dans auditLogs et notifie l'appelant — de façon atomique.
    // ----------------------------------------------------------

    // La cible du recours appartient-elle à l'appelant (auth.uid) ?
    // post/comment : auteur du contenu ; user : l'appelant lui-même
    // (on ne peut pas contester la sanction d'autrui).
    function isAppealTargetOwned(targetType, targetId) {
      return (targetType == 'post')
        ? (exists(/databases/$(database)/documents/posts/$(targetId))
            && get(/databases/$(database)/documents/posts/$(targetId)).data.authorId == request.auth.uid)
        : (targetType == 'comment')
          ? (exists(/databases/$(database)/documents/comments/$(targetId))
              && get(/databases/$(database)/documents/comments/$(targetId)).data.authorId == request.auth.uid)
          : targetId == request.auth.uid;
    }

    // La cible est-elle RÉELLEMENT sanctionnée au moment du dépôt, et
    // sanctionType cohérent avec son état actuel ?
    // post/comment : moderationStatus == sanctionType ('hidden' ou
    // 'removed'). user : 'warned' si moderationStatus == 'warned' ;
    // 'suspended'/'banned' si banned == true et
    // moderationStatus == 'suspended'.
    function isAppealTargetSanctioned(targetType, targetId, sanctionType) {
      return (targetType == 'post')
        ? ((sanctionType == 'hidden' || sanctionType == 'removed')
            && exists(/databases/$(database)/documents/posts/$(targetId))
            && get(/databases/$(database)/documents/posts/$(targetId)).data.moderationStatus == sanctionType)
        : (targetType == 'comment')
          ? ((sanctionType == 'hidden' || sanctionType == 'removed')
              && exists(/databases/$(database)/documents/comments/$(targetId))
              && get(/databases/$(database)/documents/comments/$(targetId)).data.moderationStatus == sanctionType)
          : exists(/databases/$(database)/documents/users/$(targetId))
              && ((sanctionType == 'warned'
                    && get(/databases/$(database)/documents/users/$(targetId)).data.moderationStatus == 'warned')
                  || ((sanctionType == 'suspended' || sanctionType == 'banned')
                      && get(/databases/$(database)/documents/users/$(targetId)).data.banned == true
                      && get(/databases/$(database)/documents/users/$(targetId)).data.moderationStatus == 'suspended'));
    }

    match /appeals/{appealId} {
      allow create: if canAct()
        && request.resource.data.appellantId == request.auth.uid
        && request.resource.data.appealId == appealId
        && appealId == request.auth.uid + '_' + request.resource.data.targetType + '_' + request.resource.data.targetId
        && request.resource.data.targetType in ['post', 'comment', 'user']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.sanctionType is string
        && isAppealTargetOwned(request.resource.data.targetType, request.resource.data.targetId)
        && isAppealTargetSanctioned(
             request.resource.data.targetType,
             request.resource.data.targetId,
             request.resource.data.sanctionType
           )
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 2000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly([
          'appealId', 'appellantId', 'targetType', 'targetId',
          'sanctionType', 'reason', 'status', 'createdAt'
        ]);

      // L'appelant concerné lit son recours ; les modérateurs/admins
      // peuvent tout lire (prérequis de la revue). Aucun passe-droit
      // d'écriture côté client.
      allow read: if isSignedIn()
        && (resource.data.appellantId == request.auth.uid || isModerator());

      // La décision (accepted/rejected) passe exclusivement par la
      // Cloud Function `reviewAppeal`. Le client (appelant, modérateur,
      // admin) ne peut JAMAIS modifier ni supprimer un recours.
      allow update, delete: if false;
    }

    // ----------------------------------------------------------
    // Collections prévues pour les phases suivantes (DENY BY DEFAULT
    // jusqu'à implémentation) : hashtags, creatorStats.
    // ----------------------------------------------------------
    match /hashtags/{docId} {
      allow read, write: if false;
    }
    match /creatorStats/{docId} {
      allow read, write: if false;
    }

    // Toute autre collection : refus systématique.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}