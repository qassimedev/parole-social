rules_version = '2';
service cloud.firestore {
  // ============================================================
  // PAROLE - Règles Firestore (Phase 1 à Phase 6)
  // PRINCIPE ABSOLU : DENY BY DEFAULT.
  //   - Aucune lecture/écriture sans règle explicite.
  //   - Un utilisateur ne peut modifier que ses propres données.
  //   - Les champs sensibles (role, banned, counters, modération,
  //     auditLogs) ne sont JAMAIS modifiables par un client.
  //   - Toutes les mutations sensibles passent par les Cloud
  //     Functions (Admin SDK) qui écrivent aussi auditLogs.
  // ============================================================

  match /databases/{database}/documents {

    // ----------------------------------------------------------
    // Helpers
    // ----------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Rôle d'un utilisateur. 'none' si le profil n'existe pas
    // (couvre les cas limite sans lever d'erreur).
    function getUserRole(uid) {
      return userDocExists(uid) ? getUserData(uid).role : 'none';
    }

    function isAdmin() {
      return isSignedIn() && getUserRole(request.auth.uid) == 'admin';
    }

    function isModerator() {
      return isSignedIn() && getUserRole(request.auth.uid) in ['moderator', 'admin'];
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBanned(uid) {
      return userDocExists(uid) && getUserData(uid).banned == true;
    }

    // Un compte peut créer du contenu : connecté, profil présent,
    // non banni.
    function canAct() {
      return isSignedIn() && userDocExists(request.auth.uid) && !isBanned(request.auth.uid);
    }

    // L'utilisateur suit-il l'auteur ? (collection `follows`,
    // prévue pour une phase ultérieure. Par défaut : non.)
    function followsAuthor(authorId) {
      return exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + authorId));
    }

    // Un post (données déjà récupérées) est-il lisible ?
    function isPostDataReadable(data) {
      return isSignedIn()
        && (data.authorId == request.auth.uid
            || isModerator()
            || (!('deletedAt' in data)
                && data.moderationStatus == 'visible'
                && (data.visibility == 'public'
                    || (data.visibility == 'followers' && followsAuthor(data.authorId)))));
    }

    // Un post est-il lisible par le demandeur ? (appelé avec `get`)
    function isPostReadable(postId) {
      return isSignedIn()
        && (isModerator()
            || (exists(/databases/$(database)/documents/posts/$(postId))
                && isPostDataReadable(get(/databases/$(database)/documents/posts/$(postId)).data)));
    }

    function validReason(reason) {
      return reason in ['illegal', 'harassment', 'spam', 'hate', 'sexual', 'violence', 'doxxing', 'fraud', 'other'];
    }

    // ----------------------------------------------------------
    // users/{userId}
    // Champs publics : uid, displayName, bio, avatarPath, createdAt,
    // updatedAt.
    // Champs système (jamais écrits par un client) : role, banned,
    // bannedUntil, moderationStatus, moderationNote, postCount,
    // reportCount, likeCount, followerCount, followingCount,
    // notificationCount.
    // ----------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();

      // Création du profil : l'utilisateur ne peut créer QUE son
      // propre profil, avec le rôle par défaut 'user', non banni.
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.banned == false
        && !('bannedUntil' in request.resource.data)
        && request.resource.data.moderationStatus == 'none'
        && request.resource.data.postCount == 0
        && request.resource.data.reportCount == 0
        && request.resource.data.likeCount == 0
        && request.resource.data.followerCount == 0
        && request.resource.data.followingCount == 0
        && request.resource.data.notificationCount == 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'bio', 'avatarPath', 'createdAt',
          'updatedAt', 'role', 'banned', 'moderationStatus',
          'postCount', 'reportCount', 'likeCount',
          'followerCount', 'followingCount', 'notificationCount'
        ]);

      // Mise à jour par le propriétaire : champs de profil uniquement.
      // Interdit de toucher role, banned, moderationStatus, counters.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'bio', 'avatarPath', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.banned == resource.data.banned
        && request.resource.data.moderationStatus == resource.data.moderationStatus
        && request.resource.data.postCount == resource.data.postCount
        && request.resource.data.reportCount == resource.data.reportCount
        && request.resource.data.likeCount == resource.data.likeCount
        && request.resource.data.followerCount == resource.data.followerCount
        && request.resource.data.followingCount == resource.data.followingCount
        && request.resource.data.notificationCount == resource.data.notificationCount;

      // Suppression de profil : jamais via un client.
      allow delete: if false;
    }

    // ----------------------------------------------------------
    // posts/{postId}
    // Champs système : likeCount, commentCount, reportCount,
    // shareCount (incréments via Cloud Functions uniquement),
    // moderationStatus, moderationReason, moderatorId, moderatedAt.
    // ----------------------------------------------------------
    match /posts/{postId} {
      allow read: if isPostDataReadable(resource.data);

      allow create: if canAct()
        && request.resource.data.authorId == request.auth.uid
        && 'content' in request.resource.data
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 5000
        && request.resource.data.type in ['text', 'image', 'video', 'audio']
        && request.resource.data.visibility in ['public', 'followers', 'private']
        && request.resource.data.moderationStatus == 'visible'
        && !('deletedAt' in request.resource.data)
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.reportCount == 0
        && request.resource.data.shareCount == 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'authorId', 'authorName', 'content', 'type', 'visibility',
          'mediaPaths', 'createdAt', 'updatedAt', 'likeCount',
          'commentCount', 'reportCount', 'shareCount', 'moderationStatus'
        ]);

      // L'auteur peut modifier contenu, visibilité et médias.
      // Jamais les compteurs ni les champs de modération.
      allow update: if isOwner(resource.data.authorId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['content', 'visibility', 'mediaPaths', 'updatedAt'])
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.moderationStatus == resource.data.moderationStatus
        && request.resource.data.likeCount == resource.data.likeCount
        && request.resource.data.commentCount == resource.data.commentCount
        && request.resource.data.reportCount == resource.data.reportCount
        && request.resource.data.shareCount == resource.data.shareCount;

      // Suppression : uniquement l'auteur du post.
      allow delete: if isOwner(resource.data.authorId);
    }

    // ----------------------------------------------------------
    // comments/{commentId}
    // ----------------------------------------------------------
    match /comments/{commentId} {
      // Lecture : seul le post parent doit être lisible ET le commentaire
      // doit être visible (ou le demandeur un modérateur/admin). Un
      // utilisateur normal ne lit pas un commentaire masqué/retiré, même
      // s'il est l'auteur du post parent.
      allow read: if isPostReadable(resource.data.postId)
        && (isModerator() || resource.data.moderationStatus == 'visible');

      allow create: if canAct()
        && request.resource.data.authorId == request.auth.uid
        && 'postId' in request.resource.data
        && request.resource.data.postId is string
        && isPostReadable(request.resource.data.postId)
        && 'content' in request.resource.data
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.moderationStatus == 'visible'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'postId', 'authorId', 'content', 'replyToId', 'createdAt',
          'updatedAt', 'moderationStatus', 'deletedAt'
        ]);

      allow update: if isOwner(resource.data.authorId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['content', 'updatedAt'])
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.moderationStatus == resource.data.moderationStatus;

      allow delete: if isOwner(resource.data.authorId);
    }

    // ----------------------------------------------------------
    // likes/{likeId}
    // Un like par utilisateur et par post : DÉDUPLICATION par ID
    // déterministe `likeId = ${userId}_${postId}` (imposé par la
    // règle de création). Un second like est un setDoc sur un
    // document existant -> UPDATE -> refusé. Le retrait d'un like
    // est une suppression réservée à son auteur.
    // Les compteurs (posts.likeCount et users.likeCount des likes
    // reçus) sont maintenus par les Cloud Functions
    // (onLikeCreated / onLikeDeleted) — jamais par un client.
    // ----------------------------------------------------------
    match /likes/{likeId} {
      allow read: if isSignedIn();

      allow create: if canAct()
        && request.resource.data.userId == request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.postId
        && 'postId' in request.resource.data
        && request.resource.data.postId is string
        && request.resource.data.postId.size() > 0
        && isPostReadable(request.resource.data.postId)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'userId', 'postId', 'createdAt', 'updatedAt'
        ]);

      // Un like est immuable : on like ou on retire, jamais de
      // modification.
      allow update: if false;

      // Retrait d'un like : uniquement son auteur.
      allow delete: if isOwner(resource.data.userId);
    }

    // ----------------------------------------------------------
    // shares/{shareId} (Phase 6)
    // Partage / renvoi d'une publication. DÉDUPLICATION par ID
    // déterministe `shareId = ${userId}_${postId}` (imposé par la
    // règle de création). Un second partage est un setDoc sur un
    // document existant -> UPDATE -> refusé. Un partage est IMMUABLE.
    // Les compteurs (posts.shareCount) sont maintenus par les Cloud
    // Functions (onShareCreated / onShareDeleted) — jamais par un
    // client. Aucun compteur users.shareCount (un partage n'est pas
    // un indicateur valorisé du profil). Lecture : tout utilisateur
    // connecté (requête « mes partages » mono-champ, aucun index
    // composite).
    // ----------------------------------------------------------
    match /shares/{shareId} {
      allow read: if isSignedIn();

      allow create: if canAct()
        && request.resource.data.userId == request.auth.uid
        && shareId == request.auth.uid + '_' + request.resource.data.postId
        && 'postId' in request.resource.data
        && request.resource.data.postId is string
        && request.resource.data.postId.size() > 0
        && isPostReadable(request.resource.data.postId)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'userId', 'postId', 'createdAt', 'updatedAt'
        ]);

      // Un partage est immuable : on partage ou on retire, jamais de
      // modification.
      allow update: if false;

      // Retrait d'un partage : uniquement son auteur.
      allow delete: if isOwner(resource.data.userId);
    }

    // ----------------------------------------------------------
    // reports/{reportId}
    // DÉDUPLICATION : reportId = `${reporterId}_${targetType}_${targetId}`.
    // Un même utilisateur ne peut donc créer qu'UN signalement par
    // cible. Le doc id déterministe rend l'écrasement impossible
    // (un second signalement serait un update → refusé).
    // AUCUN signalement ne supprime, ne masque ni ne modifie un post.
    // ----------------------------------------------------------
    match /reports/{reportId} {
      allow create: if canAct()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportId == reportId
        && reportId == request.auth.uid + '_' + request.resource.data.targetType + '_' + request.resource.data.targetId
        && request.resource.data.targetType in ['post', 'comment', 'user']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && validReason(request.resource.data.reason)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        // La cible doit exister.
        && (request.resource.data.targetType != 'post'
            || exists(/databases/$(database)/documents/posts/$(request.resource.data.targetId)))
        && request.resource.data.keys().hasOnly([
          'reporterId', 'reportId', 'targetType', 'targetId',
          'reason', 'details', 'status', 'createdAt'
        ]);

      // L'auteur du signalement peut le lire ; les modérateurs
      // peuvent tout lire.
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.reporterId || isModerator());

      // Le statut/résolution d'un signalement n'est modifiable que
      // par les Cloud Functions (Admin SDK), pour traçabilité.
      allow update, delete: if false;
    }

    // ----------------------------------------------------------
    // moderationQueue/{queueId}
    // Créée et mise à jour par les Cloud Functions (déclencheurs
    // onReportCreated + actions de modération). Aucun client ne peut
    // écrire ici. États : pending, reviewing, resolved, dismissed.
    // ----------------------------------------------------------
    match /moderationQueue/{queueId} {
      allow read: if isSignedIn() && isModerator();
      allow create, update, delete: if false;
    }

    // ----------------------------------------------------------
    // notifications/{notificationId}
    // Créées EXCLUSIVEMENT par les Cloud Functions (Admin SDK) :
    // le client ne peut ni créer ni supprimer une notification et
    // ne peut modifier ni recipientId, ni actorId, ni type, ni
    // postId, ni commentId, ni createdAt. Le destinataire peut
    // UNIQUEMENT marquer une notification NON LUE comme lue
    // (read = true + readAt timestamp). Une notification déjà lue
    // est immuable — ceci rend le décrément de
    // users.notificationCount exactement unitaire (idempotent).
    // ----------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && (resource.data.recipientId == request.auth.uid || isAdmin());

      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.actorId == resource.data.actorId
        && request.resource.data.type == resource.data.type
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.commentId == resource.data.commentId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read', 'readAt'])
        && request.resource.data.read == true
        && request.resource.data.readAt is timestamp
        && !(resource.data.read == true);

      allow create, delete: if false;
    }

    // ----------------------------------------------------------
    // auditLogs/{logId}
    // Journal des actions administratives et de modération. Écrit
    // EXCLUSIVEMENT par les Cloud Functions (Admin SDK). Lecture
    // réservée aux administrateurs.
    // ----------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isSignedIn() && isAdmin();
      allow create, update, delete: if false;
    }

    // ----------------------------------------------------------
    // follows/{followId}
    // Abonnements. DÉDUPLICATION par ID déterministe
    // `followId = ${followerId}_${followingId}` (imposé par la règle
    // de création). Un second follow est un setDoc sur un document
    // existant -> UPDATE -> refusé. Un follow est IMMUABLE : le
    // retrait est une suppression réservée au follower.
    // Ininterdits : se suivre soi-même, suivre un profil inexistant
    // ou un profil banni; un utilisateur banni ne peut pas suivre
    // (canAct()).
    // Les compteurs (users.followingCount du suiveur et
    // users.followerCount du suivi) sont maintenus par les Cloud
    // Functions (onFollowCreated / onFollowDeleted) — jamais par un
    // client.
    // ----------------------------------------------------------
    match /follows/{followId} {
      // Lecture : le follower, le suivi, ou modérateur/admin. Une
      // telle règle empêche d'énumérer les abonnements d'autrui ;
      // la visibilité `followers` des posts ne dépend pas de ce droit
      // de lecture (exists() reste autorisé dans les règles).
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.followerId
            || request.auth.uid == resource.data.followingId
            || isModerator());

      allow create: if canAct()
        && request.resource.data.followerId == request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followingId
        && 'followingId' in request.resource.data
        && request.resource.data.followingId is string
        && request.resource.data.followingId.size() > 0
        && request.resource.data.followingId != request.auth.uid
        // La cible doit exister et ne pas être bannie.
        && exists(/databases/$(database)/documents/users/$(request.resource.data.followingId))
        && !isBanned(request.resource.data.followingId)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'followerId', 'followingId', 'createdAt', 'updatedAt'
        ]);

      // Un follow est immuable : on suit ou on ne suit plus.
      allow update: if false;

      // Retrait d'un follow : uniquement le follower.
      allow delete: if isOwner(resource.data.followerId);
    }

    // ----------------------------------------------------------
    // Collections prévues pour les phases suivantes (DENY BY DEFAULT
    // jusqu'à implémentation) : appeals, messages, hashtags,
    // creatorStats.
    // ----------------------------------------------------------
    match /appeals/{docId} {
      allow read, write: if false;
    }
    match /messages/{docId} {
      allow read, write: if false;
    }
    match /hashtags/{docId} {
      allow read, write: if false;
    }
    match /creatorStats/{docId} {
      allow read, write: if false;
    }

    // Toute autre collection : refus systématique.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}